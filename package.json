{
    "name": "@sebbebroman/fast-csv",
    "version": "0.1.0",
    "description": "Isomorphic ESM CSV parser and formatter with optional Node.js stream and file APIs",
    "main": "./dist/index.js",
    "types": "./dist/types/index.d.ts",
    "scripts": {
        "clean": "rm -rf dist",
        "build": "pnpm run clean && vite build && tsc -p tsconfig.types.json",
        "build:examples": "pnpm --filter \"./examples/*\" --if-present run build",
        "prepublishOnly": "pnpm test && pnpm run build && pnpm run verify:package && pnpm run bundle:size",
        "release": "pnpm publish --access public",
        "test": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:unit",
        "test:unit": "vitest run --coverage",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint --deny-warnings src __tests__ scripts examples vite.config.ts vitest.config.ts",
        "lint:fix": "pnpm run lint --fix",
        "examples": "pnpm -r --if-present run all-examples",
        "benchmarks": "pnpm -r --if-present run benchmarks",
        "bundle:size": "node scripts/bundle-size.cjs",
        "verify:package": "node scripts/verify-packages.cjs"
    },
    "files": [
        "dist/**",
        "CHANGELOG.md",
        "LICENSE",
        "README.md"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/SebbeBroman/fast-csv.git"
    },
    "keywords": [
        "csv",
        "parser",
        "fast",
        "writer",
        "csv writer",
        "CSV"
    ],
    "homepage": "https://github.com/SebbeBroman/fast-csv#readme",
    "author": {
        "name": "sebbebroman",
        "url": "https://github.com/SebbeBroman"
    },
    "license": "MIT",
    "engines": {
        "node": ">=20.0.0"
    },
    "module": "./dist/index.js",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json",
        "./browser": {
            "types": "./dist/types/index.d.ts",
            "default": "./dist/index.js"
        },
        "./node": {
            "types": "./dist/types/node.d.ts",
            "default": "./dist/node.js"
        }
    },
    "typesVersions": {
        "*": {
            "browser": [
                "dist/types/index.d.ts"
            ],
            "node": [
                "dist/types/node.d.ts"
            ],
            "*": [
                "dist/types/index.d.ts"
            ]
        }
    },
    "sideEffects": false,
    "type": "module",
    "bugs": {
        "url": "https://github.com/SebbeBroman/fast-csv/issues"
    },
    "contributors": [
        {
            "name": "sebbebroman",
            "url": "https://github.com/SebbeBroman"
        },
        {
            "name": "Doug Martin",
            "url": "https://github.com/dougamartin"
        },
        {
            "name": "C2FO",
            "url": "https://github.com/C2FO"
        }
    ],
    "publishConfig": {
        "access": "public"
    },
    "packageManager": "pnpm@10.34.4",
    "devDependencies": {
        "@types/node": "24.12.3",
        "@vitest/coverage-v8": "^5.0.2",
        "oxfmt": "^0.70.0",
        "oxlint": "^1.85.0",
        "typescript": "5.9.3",
        "vite": "^8.3.1",
        "vitest": "^5.0.2"
    },
    "pnpm": {
        "overrides": {
            "@babel/core": "7.29.7",
            "@nx/devkit": "22.7.7",
            "@sigstore/core": "3.2.1",
            "axios": "1.19.0",
            "body-parser": "1.20.6",
            "brace-expansion@^1.0.0": "1.1.18",
            "brace-expansion@^2.0.0": "2.1.4",
            "brace-expansion@^5.0.0": "5.0.9",
            "form-data": "4.0.6",
            "fast-uri": "3.1.5",
            "http-proxy-middleware": "2.0.10",
            "ip-address": "10.3.1",
            "joi": "18.2.1",
            "js-yaml@^3.13.1": "3.15.1",
            "js-yaml@^4.1.0": "4.3.1",
            "launch-editor": "2.14.1",
            "nanoid": "3.3.18",
            "nx": "22.7.7",
            "postcss": "8.5.26",
            "qs": "6.15.2",
            "serialize-javascript": "7.0.5",
            "shell-quote": "1.10.0",
            "sigstore": "4.1.1",
            "svgo@^3.0.0": "3.3.4",
            "tar": "7.5.22",
            "tmp": "0.2.7",
            "undici": "6.28.0",
            "uuid": "11.1.1",
            "webpack-dev-server": "5.2.6",
            "websocket-driver": "0.7.5",
            "ws@^7.0.0": "7.5.11",
            "ws@^8.0.0": "8.21.0"
        }
    }
}
