{
    "extends": "./tsconfig.build.json",
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "bundler",
        "types": ["node", "vitest/globals"],
        "noEmit": true,
        "isolatedModules": true
    },
    "include": ["src/**/*.ts", "__tests__/**/*.ts", "vite.config.ts", "vitest.config.ts"]
}
