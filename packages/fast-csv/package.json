{
    "name": "@sebbro/fast-csv",
    "version": "1.0.0",
    "description": "ESM-only CSV parser and formatter for browsers and Node.js, forked from fast-csv",
    "main": "./build/esm/src/index.js",
    "types": "./build/esm/src/index.d.ts",
    "scripts": {
        "prepublishOnly": "pnpm run build",
        "build": "pnpm run clean && pnpm run compile",
        "clean": "rm -rf ./build && rm -rf tsconfig.tsbuildinfo",
        "compile": "node ../../scripts/build-fork.cjs"
    },
    "directories": {
        "lib": "src",
        "test": "__tests__"
    },
    "files": [
        "build/esm/**",
        "CHANGELOG.md"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/SebbeBroman/fast-csv.git",
        "directory": "packages/fast-csv"
    },
    "keywords": [
        "csv",
        "parser",
        "fast",
        "writer",
        "csv writer",
        "CSV"
    ],
    "homepage": "https://github.com/SebbeBroman/fast-csv#readme",
    "author": "Doug Martin",
    "license": "MIT",
    "engines": {
        "node": ">=20.0.0"
    },
    "module": "./build/esm/src/index.js",
    "exports": {
        ".": {
            "types": "./build/esm/src/index.d.ts",
            "default": "./build/esm/src/index.js"
        },
        "./package.json": "./package.json",
        "./browser": {
            "types": "./build/esm/src/browser.d.ts",
            "default": "./build/esm/src/browser.js"
        },
        "./node": {
            "types": "./build/esm/src/index.d.ts",
            "default": "./build/esm/src/index.js"
        }
    },
    "typesVersions": {
        "*": {
            "browser": [
                "build/esm/src/browser.d.ts"
            ],
            "node": [
                "build/esm/src/index.d.ts"
            ]
        }
    },
    "sideEffects": false,
    "type": "module",
    "bugs": {
        "url": "https://github.com/SebbeBroman/fast-csv/issues"
    },
    "contributors": [
        {
            "name": "sebbro"
        }
    ],
    "devDependencies": {
        "@fast-csv/parse": "workspace:*",
        "@fast-csv/format": "workspace:*"
    },
    "publishConfig": {
        "access": "public"
    }
}
