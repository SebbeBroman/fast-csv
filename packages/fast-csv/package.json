{
    "name": "fast-csv",
    "version": "5.0.7",
    "description": "CSV parser and writer",
    "main": "./build/esm/src/index.js",
    "types": "./build/esm/src/index.d.ts",
    "scripts": {
        "prepublishOnly": "pnpm run build",
        "build": "pnpm run clean && pnpm run compile",
        "clean": "rm -rf ./build && rm -rf tsconfig.tsbuildinfo",
        "compile": "tsc --noEmit && node ../../scripts/build-esm.cjs"
    },
    "directories": {
        "lib": "src",
        "test": "__tests__"
    },
    "files": [
        "build/esm/**"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/C2FO/fast-csv.git",
        "directory": "packages/fast-csv"
    },
    "keywords": [
        "csv",
        "parser",
        "fast",
        "writer",
        "csv writer",
        "CSV"
    ],
    "homepage": "https://c2fo.github.io/fast-csv",
    "author": "Doug Martin",
    "license": "MIT",
    "engines": {
        "node": ">=20.0.0"
    },
    "dependencies": {
        "@fast-csv/format": "5.0.7",
        "@fast-csv/parse": "5.0.7"
    },
    "module": "./build/esm/src/index.js",
    "exports": {
        ".": {
            "types": "./build/esm/src/index.d.ts",
            "default": "./build/esm/src/index.js"
        },
        "./package.json": "./package.json",
        "./browser": {
            "types": "./build/esm/src/browser.d.ts",
            "default": "./build/esm/src/browser.js"
        }
    },
    "typesVersions": {
        "*": {
            "browser": [
                "build/esm/src/browser.d.ts"
            ]
        }
    }
}
